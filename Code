#include <stdio.h>
#include <string.h>

#define MAX 20

char names[MAX][20];
int  isDir[MAX];
int  adj[MAX][MAX];
int  n = 0;

int addNode(const char *name, int dir) {
    strcpy(names[n], name);
    isDir[n] = dir;
    return n++;
}

void addEdge(int parent, int child) {
    adj[parent][child] = 1;          /* directory -> contained item */
}

int findNode(const char *name) {
    for (int i = 0; i < n; i++)
        if (strcmp(names[i], name) == 0) return i;
    return -1;
}

void printMatrix(void) {
    printf("Adjacency Matrix:\n      ");
    for (int i = 0; i < n; i++) printf("%2d ", i);
    printf("\n");
    for (int i = 0; i < n; i++) {
        printf("%2d    ", i);
        for (int j = 0; j < n; j++) printf("%2d ", adj[i][j]);
        printf("  (%s)\n", names[i]);
    }
    printf("\n");
}

/* ---------- BFS ---------- */
int bfs(int start, const char *target) {
    int visited[MAX] = {0}, queue[MAX], front = 0, rear = 0, found = 0;
    queue[rear++] = start;
    visited[start] = 1;
    printf("BFS traversal: ");
    while (front < rear) {
        int u = queue[front++];
        printf("%s ", names[u]);
        if (strcmp(names[u], target) == 0) { found = 1; break; }
        for (int v = 0; v < n; v++)
            if (adj[u][v] && !visited[v]) {
                visited[v] = 1;
                queue[rear++] = v;
            }
    }
    printf("\n");
    return found;
}

/* ---------- DFS ---------- */
int dfsUtil(int u, int visited[], const char *target) {
    visited[u] = 1;
    printf("%s ", names[u]);
    if (strcmp(names[u], target) == 0) return 1;
    for (int v = 0; v < n; v++)
        if (adj[u][v] && !visited[v])
            if (dfsUtil(v, visited, target)) return 1;
    return 0;
}

int dfs(int start, const char *target) {
    int visited[MAX] = {0};
    printf("DFS traversal: ");
    int found = dfsUtil(start, visited, target);
    printf("\n");
    return found;
}

int main(void) {
    /* Sample file system */
    int root   = addNode("root", 1);
    int docs   = addNode("docs", 1);
    int images = addNode("images", 1);
    int src    = addNode("src", 1);
    int notes  = addNode("notes.txt", 0);
    int resume = addNode("resume.pdf", 0);
    int photo  = addNode("photo.jpg", 0);
    int logo   = addNode("logo.png", 0);
    int mainc  = addNode("main.c", 0);
    int utils  = addNode("utils.c", 0);

    addEdge(root, docs);    addEdge(root, images); addEdge(root, src);
    addEdge(docs, notes);   addEdge(docs, resume);
    addEdge(images, photo); addEdge(images, logo);
    addEdge(src, mainc);    addEdge(src, utils);

    printMatrix();

    char startName[20], target[20];
    printf("Enter starting node: ");
    scanf("%19s", startName);
    printf("Enter file to search: ");
    scanf("%19s", target);

    int start = findNode(startName);
    if (start < 0) { printf("Start node not found.\n"); return 1; }

    printf("\n");
    int f1 = bfs(start, target);
    printf("BFS result: %s %s\n\n", target, f1 ? "FOUND" : "NOT FOUND");

    int f2 = dfs(start, target);
    printf("DFS result: %s %s\n", target, f2 ? "FOUND" : "NOT FOUND");
    return 0;
}
